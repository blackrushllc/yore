#!/bin/bash


# yore - lightweight dispatcher script

# Check if first argument is "cli"
if [[ "$1" == "cli" ]]; then
    shift # remove "cli"
    # if "cli.php" is in the current directory then..
    if [[ ! -f "cli.php" ]]; then
        echo "Error: cli.php not found in the current directory."
        exit 1
    fi

    # Run php cli.php with all remaining args
    php cli.php "$@"
else
    # Switch structure based on first argument
    case "$1" in
        import|export|show|copy|save|load|encrypt|decrypt)
            shift # remove the first argument
            echo "Would Run $1 with $*"
            ;;
        "" )
            echo "No command provided. Usage: yore [cli|import|export|show|copy|save|load|encrypt|decrypt] [args...]"
            ;;
        * )
            echo "Unknown command: $1"
            ;;
    esac
fi

echo "*** End Run Yore"
exit 0
