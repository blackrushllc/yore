#!/bin/bash


# yore - lightweight dispatcher script

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Function to show available commands
show_usage() {
    echo "Usage: yore <command> [args...]"
    echo ""
    echo "Available commands:"
    echo "  cli <args>     - Run CLI commands via cli.php"

    # Dynamically list available PHP files as commands
    for php_file in "$SCRIPT_DIR"/*.php; do
        if [[ -f "$php_file" ]]; then
            local cmd=$(basename "$php_file" .php)
            [[ "$cmd" != "cli" && "$cmd" != "index" ]] && echo "  $cmd <args>    - Run $cmd.php"
        fi
    done

    # Special commands
    echo "  encrypt <args> - Encrypt using enc.php"
    echo "  decrypt <args> - Decrypt using enc.php"
    echo "  show           - List all available PHP files"
}

# Check if no arguments provided
if [[ $# -eq 0 ]]; then
    show_usage
    exit 1
fi

COMMAND="$1"
shift # Remove command from arguments

case "$COMMAND" in
    cli)
        # Special case for CLI
        if [[ ! -f "$SCRIPT_DIR/cli.php" ]]; then
            echo "Error: cli.php not found at $SCRIPT_DIR/cli.php"
            exit 1
        fi
        php "$SCRIPT_DIR/cli.php" "$@"
        ;;
    encrypt|decrypt)
        # Special cases for encryption
        if [[ ! -f "$SCRIPT_DIR/enc.php" ]]; then
            echo "Error: enc.php not found at $SCRIPT_DIR/enc.php"
            exit 1
        fi
        php "$SCRIPT_DIR/enc.php" "$COMMAND" "$@"
        ;;
    show)
        # Show available files
        echo "Available PHP files in $SCRIPT_DIR:"
        ls -la "$SCRIPT_DIR"/*.php 2>/dev/null | awk '{print $9}' | grep -v '^$' || echo "No PHP files found"
        ;;
    help|--help|-h)
        show_usage
        ;;
    *)
        # Dynamic command handling - check if corresponding PHP file exists
        PHP_FILE="$SCRIPT_DIR/$COMMAND.php"
        if [[ -f "$PHP_FILE" ]]; then
            php "$PHP_FILE" "$@"
        else
            echo "Error: Unknown command '$COMMAND'"
            echo "No corresponding PHP file found: $PHP_FILE"
            echo ""
            show_usage
            exit 1
        fi
        ;;
esac

echo "*** End Run Yore"
exit 0
