{
    "name": "olsonhost/yore",
    "type": "project",
    "description": "The Yore Framework.",
    "keywords": [
        "framework",
        "yore"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.4.0|^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.7",
        "illuminate/events": "~11.7.0",
        "illuminate/filesystem": "~11.7.0",
        "illuminate/view": "~11.7.0",
        "jenssegers/blade": "^2.0",
        "olsonhost/ect": "dev-main",
        "olsonhost/fred": "dev-main",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^2.2",
        "twilio/sdk": "^7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^4.3",
        "phpunit/phpunit": "^8.5.8|^9.3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {

    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "modules/"
        },
        "classmap": [

        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "serve": [
            "php -S localhost:8000 -t web"
        ]
    },
    "repositories": [
    	{
	"type": "package",
	"package": {
	    "name": "olsonhost/fred",
	    "version": "dev-main",
	    "source": {
	        "url": "https://github.com/olsonhost/fred.git",
	        "type": "git",
	        "reference": "main"
	    }
	}
    }]
}
